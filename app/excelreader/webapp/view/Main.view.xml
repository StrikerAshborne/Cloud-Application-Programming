<mvc:View
    controllerName="ns.excelreader.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
        <Page
            title="Excel Reader"
            showHeader="true">
            <headerContent>
                <Button
                    id="manageTableConfigButton"
                    text="Manage Table Configurations"
                    icon="sap-icon://action-settings"
                    type="Transparent"
                    press=".onNavigateToConfigurations"
                />
            </headerContent>

            <content>
                <VBox
                    class="sapUiMediumMargin"
                    width="100%">

                    <Title
                        text="Excel Import"
                        level="H2"/>

                    <Text
                        text="Upload and manage your Excel data."
                        class="sapUiSmallMarginBottom"/>

                    <Button
                        text="Upload Excel File"
                        type="Emphasized"
                        icon="sap-icon://upload"
                        press=".onUploadExcel"/>

                    <VBox
                        wrap="Wrap"
                        class="sapUiSmallMarginTop sapUiSmallMarginBottom">

                        <Label
                            text="Uploaded Excel files:"
                            labelFor="importSelect"
                        />
                        <!-- Excel import -->
                        <Select
                            id="importSelect"
                            width="20rem"
                            forceSelection="false"
                            items="{
                                path: '/Imports',
                                parameters: {
                                    $orderby: 'createdAt desc'
                                }
                            }">

                            <core:Item
                                key="{ID}"
                                text="{= ${filename} + ' (' + ${totalRows} + ' rows)' }"/>

                        </Select>

                        <Label
                            text="Table configurations:"
                            labelFor="configurationSelect"
                        />
                        <!-- Table configuration -->
                        <Select
                            id="configurationSelect"
                            width="20rem"
                            forceSelection="false"
                            items="{
                                path: '/TableConfigurations',
                                parameters: {
                                    $orderby: 'name'
                                }
                            }">

                            <core:Item
                                key="{ID}"
                                text="{name}"/>

                        </Select>


                        <!-- Load -->
                        <Button
                            text="Load Data"
                            type="Emphasized"
                            icon="sap-icon://download"
                            press=".onLoadData"
                            class="sapUiSmallMarginTop"/>

                    </VBox>

                    <Title
                        text="Imported Data"
                        level="H3"
                        class="sapUiMediumMarginTop"/>


                    <HBox
                        width="100%"
                        justifyContent="Center"
                        class="sapUiMediumMarginTop">

                        <Table
                            id="importedDataTable"
                            growing="true"
                            growingScrollToLoad="true"
                            inset="false"
                            width="80%"
                            noDataText="Select an Excel import and press Load Data.">

                            <headerToolbar>
                                <Toolbar>
                                    <Title
                                        text="{table>/filename}"
                                        level="H4"/>

                                    <ToolbarSpacer/>

                                    <Text
                                        text="{= ${table>/totalRows} + ' rows' }"/>
                                </Toolbar>
                            </headerToolbar>
                        </Table>
                    </HBox>
                </VBox>
            </content>
        </Page>
</mvc:View>